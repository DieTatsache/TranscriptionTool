# Local development configuration. Copy to `.env` (git-ignored) and adjust.
# Lists every setting of sonora/config.py. Active lines are what local development needs;
# commented lines show the default (or an example where the default is "unset"), so a line
# only changes something once it is uncommented and edited. Environment variables named
# SONORA_... take precedence over this file.

# --- General ------------------------------------------------------------------------------
# development, test or production (production refuses unsafe settings at startup).
SONORA_ENVIRONMENT=development
SONORA_LOG_LEVEL=INFO
# One JSON object per log line (what the Docker stack uses).
# SONORA_LOG_JSON=false
# API documentation at /api/v1/docs. Unset: on everywhere except in production.
# SONORA_DOCS_ENABLED=true

# --- Database -----------------------------------------------------------------------------
# SQLite file for local development (PostgreSQL in Docker/production).
SONORA_DATABASE_URL=sqlite+aiosqlite:///./data/sonora.db
# Logs every SQL statement with its parameters. Debugging only; refused in production.
# SONORA_DATABASE_ECHO=false

# --- HTTP, cookies & sign-ins ------------------------------------------------------------
# The Vite dev server runs on plain http://localhost, so the session cookie can't
# use the Secure flag / __Host- prefix here. Never set this to false in production.
SONORA_COOKIE_SECURE=false
# Origins allowed to send state-changing requests (comma-separated).
SONORA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Host header allow-list (comma-separated); "*" is refused in production.
# SONORA_ALLOWED_HOSTS=*
# Absolute and inactivity lifetime of a sign-in.
# SONORA_SESSION_TTL_HOURS=336
# SONORA_SESSION_IDLE_HOURS=72
# Strict-Transport-Security header; only for sites served exclusively over HTTPS.
# SONORA_HSTS_ENABLED=false
# Largest JSON request body in KiB (audio uploads have their own limit below).
# SONORA_MAX_JSON_BODY_KB=64

# --- Accounts & billing ------------------------------------------------------------------
# SONORA_REGISTRATION_ENABLED=true
# SONORA_PASSWORD_MIN_LENGTH=12
# Plan of self-registered accounts: free (one session a month, up to 60 min), none (no
# uploads until one is bought in the checkout), or trainer, pro to give every new account
# that plan for free.
# SONORA_DEFAULT_PLAN=free
# Payment provider of the checkout; "mock" (simulated card payments, no money moves) is
# the only one so far.
# SONORA_BILLING_PROVIDER=mock
# Cost of the Argon2id password hash (memory in KiB).
# SONORA_ARGON2_TIME_COST=3
# SONORA_ARGON2_MEMORY_COST_KIB=65536
# SONORA_ARGON2_PARALLELISM=4
# Sign-in lockout: at most this many failed attempts per account within the window.
# SONORA_LOGIN_MAX_FAILURES=5
# SONORA_LOGIN_LOCKOUT_MINUTES=15

# --- Rate limiting -----------------------------------------------------------------------
# Also enforces the sign-in lockout; refused as false in production.
# SONORA_RATE_LIMIT_ENABLED=true
# memory:// counts per process; async+valkey://host:6379 shares the counts between processes.
# SONORA_RATE_LIMIT_STORAGE_URL=memory://

# --- Uploads & storage --------------------------------------------------------------------
# Uploaded audio, shared by the API and the worker.
SONORA_STORAGE_DIR=./data
# SONORA_MAX_UPLOAD_MB=200
# SONORA_MAX_AUDIO_MINUTES=180
# Keep the audio after transcription (deleted by default: data minimisation).
# SONORA_KEEP_AUDIO=false

# --- LLM (Ollama) -------------------------------------------------------------------------
# Local Ollama (https://ollama.com): `ollama pull qwen3.5:9b`
# 16k context fits next to the 9B model on an 8 GB GPU; use 32768 with 12 GB+.
SONORA_LLM_BASE_URL=http://localhost:11434
SONORA_LLM_MODEL=qwen3.5:9b
SONORA_LLM_CONTEXT_TOKENS=16384
# Timeout of one LLM call in seconds.
# SONORA_LLM_TIMEOUT_SECONDS=600
# LLM calls one process sends at a time; more wait in line.
# SONORA_LLM_MAX_CONCURRENCY=2
# How long Ollama keeps the model loaded after a call: a duration ("10m", "24h", "-1m" =
# forever) or seconds. Unset: the Ollama server's own setting (5 minutes unless configured).
# SONORA_LLM_KEEP_ALIVE=10m
# Sampling (Qwen3.5's recommendation without reasoning); some tasks adjust it, see docs/LLM.md.
# SONORA_LLM_TEMPERATURE=0.7
# SONORA_LLM_TOP_P=0.8
# SONORA_LLM_TOP_K=20
# SONORA_LLM_PRESENCE_PENALTY=1.5

# --- Transcription ------------------------------------------------------------------------
# "faster-whisper" (real) or "fake" (returns a sample transcript; refused in production).
# The model is a name (downloaded from Hugging Face on first use) or a local model
# directory, e.g. ./data/models/faster-whisper-small
SONORA_TRANSCRIPTION_BACKEND=fake
SONORA_WHISPER_MODEL=small
# auto (GPU if available), cuda or cpu.
SONORA_WHISPER_DEVICE=cpu
# Where downloaded models are kept. Unset: the Hugging Face cache.
# SONORA_WHISPER_MODEL_DIR=./data/models
# "default" = float16 on a GPU, int8 on the CPU.
# SONORA_WHISPER_COMPUTE_TYPE=default
# SONORA_WHISPER_BEAM_SIZE=5
# Language of uploads set to automatic detection, e.g. de. Unset: detected per recording.
# SONORA_WHISPER_LANGUAGE=en
# CPU threads for transcription; 0 = the library's default.
# SONORA_WHISPER_CPU_THREADS=0

# --- Background worker --------------------------------------------------------------------
# Runs the background worker inside the API process (one command to start everything).
SONORA_WORKER_EMBEDDED=true
# How often an idle worker looks for new jobs, in seconds.
# SONORA_WORKER_POLL_SECONDS=2.0
# Attempts per job, and after how many seconds the job of a crashed worker is taken over.
# SONORA_JOB_MAX_ATTEMPTS=3
# SONORA_JOB_LEASE_SECONDS=300
