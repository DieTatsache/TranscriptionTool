# Sonora web server: serves the SPA and forwards /api to the backend (same origin, no CORS).
# ${VARS} are filled in by the nginx image's envsubst step at container start.

# Share links are bearer tokens: keep them out of the access log.
map $request_uri $loggable_uri {
    "~^(?<prefix>/(?:api/v1/public/shares|share)/)[A-Za-z0-9_-]+(?<rest>.*)$" "${prefix}[redacted]${rest}";
    default $request_uri;
}
# rid matches the API's X-Request-ID, so web and API logs can be correlated.
log_format sonora '$remote_addr [$time_local] "$request_method $loggable_uri $server_protocol" '
                  '$status $body_bytes_sent $request_time rid=$request_id "$http_user_agent"';

server {
    listen 8080;
    server_name _;
    server_tokens off;
    access_log /dev/stdout sonora;

    # Only a TLS proxy in front of this container (TRUSTED_PROXY_CIDR) may set the client IP;
    # everyone else's X-Forwarded-For is ignored. The default trusts nobody.
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    root /usr/share/nginx/html;
    client_max_body_size ${MAX_UPLOAD_MB}m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Overwrite (never append) so clients can't inject addresses used for rate limiting.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        # Stream uploads straight through; the API enforces size and type while reading.
        proxy_request_buffering off;
        client_body_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;  # chat answers from local models can take a while
    }

    location /assets/ {
        # Fingerprinted build output: cache forever.
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location / {
        # SPA routes (/, /share/<token>) all serve index.html, which must always revalidate.
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
