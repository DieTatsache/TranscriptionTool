# Local development only (loaded by `npm run dev`, never by production builds).
# Demo login button on the sign-in page; the account is created by
# `uv run python -m sonora.cli seed-demo` in the Backend folder.
VITE_DEMO_EMAIL=marie.trainer@example.com
VITE_DEMO_PASSWORD=sonora-demo-2026

# Show the recap-video mock tab (not implemented in the backend yet).
VITE_FEATURE_VIDEO=false

# Where the dev server forwards /api (the FastAPI backend).
API_PROXY_TARGET=http://127.0.0.1:8000
