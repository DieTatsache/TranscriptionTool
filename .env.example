# Docker Compose configuration. Copy to `.env` next to docker-compose.yml.
# (Local development without Docker uses Backend/.env instead; see Backend/.env.example.)
#
# Lists every setting. docker-compose.yml maps the short names (LLM_MODEL, ...) onto the
# backend's SONORA_ settings; the commented SONORA_ lines show the defaults of all others.
# docker-compose.yml sets these itself, so lines for them here have no effect:
# SONORA_ENVIRONMENT (production), SONORA_DATABASE_URL (from POSTGRES_PASSWORD),
# SONORA_ALLOWED_HOSTS and SONORA_ALLOWED_ORIGINS (from PUBLIC_HOST and PUBLIC_ORIGIN),
# SONORA_COOKIE_SECURE (true), SONORA_RATE_LIMIT_STORAGE_URL (Valkey), SONORA_STORAGE_DIR,
# SONORA_WORKER_EMBEDDED (false: separate worker), SONORA_LOG_JSON (true),
# SONORA_LLM_BASE_URL, SONORA_TRANSCRIPTION_BACKEND, SONORA_WHISPER_MODEL_DIR.

# --- Public address -----------------------------------------------------------------------
# PUBLIC_ORIGIN must match what users type in the browser.
PUBLIC_HOST=sonora.example.com
PUBLIC_ORIGIN=https://sonora.example.com
# Host port of the web container (not used with docker-compose.tls.yml); 127.0.0.1:8080
# accepts connections from this machine only (local trial, or a proxy on the same host).
HTTP_PORT=8080
# Only behind your own TLS proxy: its address as seen by the web container, the one source
# allowed to set the client IP (X-Forwarded-For). docker-compose.tls.yml sets it for Caddy.
# TRUSTED_PROXY_CIDR=127.0.0.1/32
# Set to true once the site is served exclusively over HTTPS (automatic with the TLS override).
HSTS_ENABLED=false

# --- Database -----------------------------------------------------------------------------
# REQUIRED: long random value, e.g. `openssl rand -base64 36`. It becomes part of the
# database URL, so it must not contain "@", "%" or "$".
POSTGRES_PASSWORD=
# Logs every SQL statement with its parameters. Development only; refused in production.
# SONORA_DATABASE_ECHO=false

# --- Accounts, sign-ins & billing ---------------------------------------------------------
# Public sign-up. While payments are simulated, anyone who signs up can "buy" Pro with a test
# card and fill the processing queue: on a public server, set false and create accounts with
# `docker compose exec api python -m sonora.cli create-user ... --plan pro`.
REGISTRATION_ENABLED=true
# Plan of self-registered accounts. "free" = one session a month (recordings up to 60 min),
# offered on the pricing page; "none" = no free tier, no uploads until a plan is bought in
# the (simulated) checkout. "trainer" or "pro" give every new account that plan for free
# (e.g. for a closed beta).
DEFAULT_PLAN=free
# SONORA_PASSWORD_MIN_LENGTH=12
# Absolute and inactivity lifetime of a sign-in.
# SONORA_SESSION_TTL_HOURS=336
# SONORA_SESSION_IDLE_HOURS=72
# Sign-in lockout: at most this many failed attempts per account within the window.
# SONORA_LOGIN_MAX_FAILURES=5
# SONORA_LOGIN_LOCKOUT_MINUTES=15
# Cost of the Argon2id password hash (memory in KiB).
# SONORA_ARGON2_TIME_COST=3
# SONORA_ARGON2_MEMORY_COST_KIB=65536
# SONORA_ARGON2_PARALLELISM=4
# Payment provider of the checkout; "mock" (simulated card payments, no money moves) is
# the only one so far.
# SONORA_BILLING_PROVIDER=mock

# --- API ----------------------------------------------------------------------------------
# API processes (rate limits are shared through Valkey).
API_WORKERS=2
# Largest JSON request body in KiB (audio uploads have their own limit below).
# SONORA_MAX_JSON_BODY_KB=64
# API documentation at /api/v1/docs. Unset: off in production.
# SONORA_DOCS_ENABLED=false
# Rate limits also enforce the sign-in lockout; production refuses to start without them.
# SONORA_RATE_LIMIT_ENABLED=true

# --- Uploads ------------------------------------------------------------------------------
# Applied to nginx and the API.
MAX_UPLOAD_MB=200
MAX_AUDIO_MINUTES=180
# Keep the audio after transcription (deleted by default: data minimisation).
# SONORA_KEEP_AUDIO=false

# --- LLM (served by the ollama container) ------------------------------------------------
# Pick a model that fits your GPU memory:
#   qwen3.5:9b   (~6.6 GB + context; default, good German and English output)
#   qwen3.5:27b  (~17 GB + context; stronger, needs a 24 GB+ GPU)
# Reasoning ("thinking") and per-task sampling are set by the backend; see docs/LLM.md.
LLM_MODEL=qwen3.5:9b
LLM_CONTEXT_TOKENS=32768
LLM_TIMEOUT_SECONDS=900
# Requests the ollama container serves at the same time.
OLLAMA_NUM_PARALLEL=2
# Pin a specific Ollama release for reproducible deployments, e.g. ollama/ollama:0.35.1
OLLAMA_IMAGE=ollama/ollama:latest
# LLM calls one worker sends at a time; more wait in line.
# SONORA_LLM_MAX_CONCURRENCY=2
# How long Ollama keeps the model loaded after a call: a duration ("10m", "-1m" = forever)
# or seconds. Unset: the ollama container keeps it for 24 hours.
# SONORA_LLM_KEEP_ALIVE=24h
# Sampling defaults, tuned for Qwen3.5. Using another model family? Set its recommended values.
# SONORA_LLM_TEMPERATURE=0.7
# SONORA_LLM_TOP_P=0.8
# SONORA_LLM_TOP_K=20
# SONORA_LLM_PRESENCE_PENALTY=1.5

# --- Speech-to-text (faster-whisper) ------------------------------------------------------
# large-v3-turbo on GPU; use "small" for CPU-only hosts. auto uses the GPU when available.
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=auto
# Builds the worker image with the CUDA libraries; docker-compose.gpu.yml sets it.
# WITH_CUDA=false
# "default" = float16 on a GPU, int8 on the CPU.
# SONORA_WHISPER_COMPUTE_TYPE=default
# SONORA_WHISPER_BEAM_SIZE=5
# Language of uploads set to automatic detection, e.g. de. Unset: detected per recording.
# SONORA_WHISPER_LANGUAGE=en
# CPU threads for transcription; 0 = the library's default.
# SONORA_WHISPER_CPU_THREADS=0

# --- Background worker & logs -------------------------------------------------------------
# How often an idle worker looks for new jobs, in seconds.
# SONORA_WORKER_POLL_SECONDS=2.0
# Attempts per job, and after how many seconds the job of a crashed worker is taken over.
# SONORA_JOB_MAX_ATTEMPTS=3
# SONORA_JOB_LEASE_SECONDS=300
# SONORA_LOG_LEVEL=INFO
