# Docker Compose configuration. Copy to `.env` next to docker-compose.yml.
# (Local development without Docker uses Backend/.env instead; see Backend/.env.example.)

# Public address of the app. PUBLIC_ORIGIN must match what users type in the browser.
PUBLIC_HOST=sonora.example.com
PUBLIC_ORIGIN=https://sonora.example.com
# Host port of the web container (not used with docker-compose.tls.yml).
HTTP_PORT=8080

# REQUIRED: long random value, e.g. `openssl rand -base64 36`
POSTGRES_PASSWORD=

# LLM served by the ollama container. Pick a model that fits your GPU memory:
#   gemma3:12b  (~9 GB VRAM, strong multilingual output, default)
#   qwen3:14b   (set LLM_THINK=false in the backend env if you use a thinking model)
#   llama3.2:3b (CPU-friendly, lowest quality)
LLM_MODEL=gemma3:12b
LLM_CONTEXT_TOKENS=32768
LLM_TIMEOUT_SECONDS=900
OLLAMA_NUM_PARALLEL=2
# Pin a specific Ollama release for reproducible deployments, e.g. ollama/ollama:0.34.4
OLLAMA_IMAGE=ollama/ollama:latest

# Speech-to-text (faster-whisper). large-v3-turbo on GPU; use "small" for CPU-only hosts.
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=auto

# Accounts and limits
REGISTRATION_ENABLED=true
DEFAULT_PLAN=trainer
MAX_UPLOAD_MB=200
MAX_AUDIO_MINUTES=180
API_WORKERS=2

# Set to true once the site is served exclusively over HTTPS (automatic with the TLS override).
HSTS_ENABLED=false
